# Copiez ce fichier en .env pour un test en local (ne jamais commiter le .env réel)

# Port d'écoute (Render fournit automatiquement PORT ; 10000 en repli local)
PORT=10000

# Clé API privée FusionMoney (dashboard MoneyFusion > Paramètres) — sert au PAYOUT
# ⚠️ L'IP publique de ce serveur doit être ajoutée dans le dashboard MoneyFusion
# (section Paramètres) pour que les requêtes de retrait (payout) soient acceptées.
FUSIONMONEY_BASE_URL=https://pay.moneyfusion.net/api/v1
FUSIONMONEY_PRIVATE_KEY=votre_cle_privee_moneyfusion

# URL de l'API PAYIN (encaissement chez l'expéditeur), propre à VOTRE compte
# marchand — à copier depuis le tableau de bord MoneyFusion (section API Web).
# Sans elle, impossible d'encaisser l'expéditeur.
FUSIONMONEY_PAYIN_URL=https://www.pay.moneyfusion.net/xxxxxxxx/xxxxxxxxxxxxxxxxxx/pay/

# URL publique de votre service (utilisée pour construire le webhook_url et
# le return_url). SUR RENDER, LAISSEZ CETTE LIGNE VIDE OU SUPPRIMEZ-LA :
# Render fournit automatiquement RENDER_EXTERNAL_URL, l'app la détecte
# toute seule. Ne renseignez PUBLIC_BASE_URL que pour forcer une valeur
# différente (autre hébergeur, domaine personnalisé, test en local).
# En local : http://localhost:10000
PUBLIC_BASE_URL=

# Jeton secret pour vérifier l'origine des appels aux webhooks (ajouté en
# ?key=... dans l'URL envoyée à FusionMoney). AUCUNE ACTION REQUISE : si
# vous laissez cette ligne vide/absente, l'app en génère un automatiquement
# au démarrage. Ne renseignez WEBHOOK_SECRET que si vous voulez une valeur
# stable entre redémarrages.
WEBHOOK_SECRET=
